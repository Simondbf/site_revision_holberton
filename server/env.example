# Fichier privé : /etc/holberton-revision.env, chmod 600, ne jamais committer de secrets.
NODE_ENV=production
HBTN_PUBLIC_ORIGIN=https://revision-hbtn.soleiljaune.be
HBTN_DB_PATH=/var/lib/holberton-revision/accounts.sqlite
HBTN_BIND_HOST=127.0.0.1
HBTN_PORT=3024
# Relais SMTP Brevo déjà préparé pour l'autre application, mais à configurer ici séparément.
HBTN_SMTP_HOST=smtp-relay.brevo.com
HBTN_SMTP_PORT=587
HBTN_SMTP_USER=REMPLACER_SUR_LE_SERVEUR
HBTN_SMTP_PASSWORD=REMPLACER_SUR_LE_SERVEUR
HBTN_MAIL_FROM=contact@soleiljaune.be

# Renseigner l'e-mail administrateur seulement sur le serveur.
HBTN_ADMIN_EMAIL=
